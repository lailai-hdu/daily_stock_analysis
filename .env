# ===================================
# A股自选股智能分析系统 - 环境变量配置
# ===================================

# 自选股列表（逗号分隔，支持沪深两市代码）
# 沪市：600xxx, 601xxx, 603xxx
# 深市：000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# 数据源配置
# Tushare Pro Token（可选，从 https://tushare.pro 官网获取）
TUSHARE_TOKEN=d8a8b1c48af5fc6ddd09c714d8faffb37594e0b5d7ee1c2c35993882

# ===================================
# 定时任务配置（统一只保留一份，消除重复覆盖）
# ===================================
SCHEDULE_ENABLED=false
SCHEDULE_TIME=16:00
# 启动时是否立即运行一次
SCHEDULE_RUN_IMMEDIATELY=true
# 交易日检查：非交易日跳过执行
TRADING_DAY_CHECK_ENABLED=true

# ===================================
# AI 模型配置
# ===================================
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-12266e9697b242d69dc6efa0a989d8b3

# ===================================
# 搜索引擎配置（股票新闻）
# ===================================
# Bocha API Keys，多key逗号分隔
BOCHA_API_KEYS=sk-d015f0652fba4b79aa7e5ff1c8e08264

# ===================================
# 新闻时效与分析筛选配置（修复EWS笔误）
# ===================================
# 新闻策略窗口：ultra_short(1天) / short(3天) / medium(7天) / long(30天)
NEWS_STRATEGY_PROFILE=short
# 新闻最大时效（天）
NEWS_MAX_AGE_DAYS=3
# 乖离率阈值（%），偏离 MA5 超过此值提示不追高
BIAS_THRESHOLD=5.0

# ===================================
# Agent 策略对话配置（Web对话页）
# ===================================
AGENT_MODE=true
# Agent最多推理步数
AGENT_MAX_STEPS=10
# 启用全部内置技术策略
AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,shrink_pullback,bottom_volume,dragon_head,one_yang_three_yin,box_oscillation,chan_theory,wave_theory,emotion_cycle
# Agent架构模式 single/multi
AGENT_ARCH=single
# 多Agent编排模式（仅multi生效）
AGENT_ORCHESTRATOR_MODE=standard
# 多Agent全局超时秒
AGENT_ORCHESTRATOR_TIMEOUT_S=600
# 风控可否决买入信号
AGENT_RISK_OVERRIDE=true
# 历史记忆校准开关
AGENT_MEMORY_ENABLED=false
# 策略自动加权
AGENT_STRATEGY_AUTOWEIGHT=true
# 策略路由 auto自动选择/manual固定列表
AGENT_STRATEGY_ROUTING=auto

# ===================================
# 通知渠道配置
# ===================================
# Server酱3 微信推送
SERVERCHAN3_SENDKEY=sctp18191trggxsmangvvayyo5vrvubt

# ===================================
# 单股推送配置
# ===================================
# 单股逐只推送，不汇总统一推送
SINGLE_STOCK_NOTIFY=true
# 报告类型 simple / full / brief
REPORT_TYPE=simple
# 仅推送汇总摘要，隐藏个股详情 false=展示完整个股
REPORT_SUMMARY_ONLY=false
# 大盘+个股合并推送开关
MERGE_EMAIL_NOTIFICATION=false

# 报告渲染配置
REPORT_TEMPLATES_DIR=templates
REPORT_RENDERER_ENABLED=false
REPORT_INTEGRITY_ENABLED=true
REPORT_INTEGRITY_RETRY=1
REPORT_HISTORY_COMPARE_N=0

# ===================================
# 数据库路径
# ===================================
DATABASE_PATH=./data/stock_analysis.db

# ===================================
# 回测配置
# ===================================
BACKTEST_ENABLED=true
# 回测评估窗口交易日
BACKTEST_EVAL_WINDOW_DAYS=10
# 仅回测14天以上历史记录
BACKTEST_MIN_AGE_DAYS=14
BACKTEST_ENGINE_VERSION=v1
# 震荡中性区间 ±2%
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# 代理配置（本地开发用）
# ===================================
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=10809

# ===================================
# 系统底层配置
# ===================================
LOG_DIR=./logs
LOG_LEVEL=INFO
# 并发线程，防止接口封禁
MAX_WORKERS=3
DEBUG=false

# ===================================
# WebUI 前端页面配置
# ===================================
WEBUI_ENABLED=false
# 外网访问需改为0.0.0.0
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
WEBUI_AUTO_BUILD=true
TRUST_X_FORWARDED_FOR=false

# Web后台登录密码认证
ADMIN_AUTH_ENABLED=false
ADMIN_SESSION_MAX_AGE_HOURS=24

# ===========================================
# 数据源拉取优先级配置
# 数字越小优先级越高
# ===========================================
# EFINANCE_PRIORITY=0
# EFINANCE_CALL_TIMEOUT=30
# AKSHARE_PRIORITY=1
# TUSHARE_PRIORITY=2
# PYTDX_PRIORITY=2
# PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3
# YFINANCE_PRIORITY=4

# ===========================================
# 实时行情数据源优先级（修复重复定义）
# ===========================================
# 优先腾讯行情，其次新浪、东财
REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 实时行情总开关
ENABLE_REALTIME_QUOTE=true
# 盘中实时计算均线技术指标
ENABLE_REALTIME_TECHNICAL_INDICATORS=true
# 筹码分布接口（不稳定，云端建议false）
ENABLE_CHIP_DISTRIBUTION=true
# 基本面数据采集管道
ENABLE_FUNDAMENTAL_PIPELINE=true

# 基本面接口超时、重试、缓存参数
FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=1.5
FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=0.8
FUNDAMENTAL_RETRY_MAX=1
FUNDAMENTAL_CACHE_TTL_SECONDS=120
FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# 投资组合风控阈值
# ===========================================
# 单只个股仓位集中度预警35%
PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# 账户最大回撤预警15%
PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# 个股止损预警阈值10%
PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# 接近止损线比例阈值
PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# 风控回溯统计周期180天
PORTFOLIO_RISK_LOOKBACK_DAYS=180
# 汇率自动更新开关
PORTFOLIO_FX_UPDATE_ENABLED=true

# 东财接口防限流补丁（频繁断开时开启true）
ENABLE_EASTMONEY_PATCH=false

# 钉钉/飞书机器人（未启用注释保留）
#DINGTALK_APP_KEY=xxxx
#DINGTALK_APP_SECRET=xxxx
#DINGTALK_STREAM_ENABLED=false
#FEISHU_APP_ID=xxxx
#FEISHU_APP_SECRET=xxxx
#FEISHU_STREAM_ENABLED=false

# 图片识图选股Vision模型Key（未配置）
#GEMINI_API_KEY=xxx
#OPENAI_API_KEY=xxx
#ANTHROPIC_API_KEY=xxx
